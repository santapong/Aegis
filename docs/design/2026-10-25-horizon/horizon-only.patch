+  --success: var(--ok);
+  --warning: var(--warn);
+  --aegis-panel: var(--pane);
+  --aegis-panel-2: var(--pane-2);
+  --aegis-line: var(--pane-edge);
+  --aegis-line-2: var(--pane-edge-2);
+  --aegis-fg-2: var(--fg-2);

+  --aegis-dim-2: var(--dim-2);
+  --aegis-ok: var(--ok);
+  --aegis-warn: var(--warn);
+  --aegis-bad: var(--bad);
+  --aegis-grid: var(--grid);
+  --display-font: var(--font-sans), sans-serif;
+  --display-style: normal;
+  --display-weight: 600;
+  --display-tracking: -0.035em;
+  --card-blur: 0px;
+  --card-radius: 16px;
+  --kpi-radius: 16px;
+  --hero-glow: none;
+  --line-glow: none;
+  --ring-glow: none;
+  --star-opacity: 0;
+}
+.aegis-brand { display: inline-flex; align-items: center; gap: 9px; color: inherit; white-space: nowrap; font: 600 27px/1 var(--font-sans), sans-serif; letter-spacing: -.065em; }
+.aegis-brand-dot { color: #75915e; }
+.theme-horizon .backdrop { background: var(--void); }
+.theme-horizon .bd-base { background: var(--void); }
+.theme-horizon .btn-galaxy { min-height: 44px; border-radius: 9px; font-family: var(--font-sans), sans-serif; font-size: 13px; letter-spacing: 0; text-transform: none; }
+.theme-horizon .btn-galaxy:not(.ghost) { background: var(--accent); color: white; }
+.theme-horizon .btn-galaxy.ghost { background: var(--pane); color: var(--fg); }
+.theme-horizon .font-mono:not(pre):not(code):not(.tabular-nums) { font-family: var(--font-sans), sans-serif; }
+.theme-horizon .aegis-sidebar { background: #edf0e7 !important; backdrop-filter: none !important; }
+.theme-horizon .aegis-sidebar nav a { min-height: 42px; border-radius: 8px !important; font-size: 13px !important; }
+.theme-horizon .aegis-sidebar nav a[aria-current="page"] { background: #dce8ce !important; box-shadow: none !important; }
+.theme-horizon .aegis-sidebar nav .kbd { opacity: .55; font-size: 9px; }
+.theme-horizon .aegis-sidebar button { min-height: 36px; }
+.theme-horizon .aegis-status { border-top: 1px solid var(--pane-edge); background: var(--void); font-family: var(--font-sans), sans-serif; letter-spacing: 0; }
+.theme-horizon [data-slot="card"] { box-shadow: 0 2px 8px #123d3203; border-radius: 16px; }
+.theme-horizon :is(input, select, textarea) { color-scheme: light; }
+.theme-horizon :is(button, a, input, select, textarea):focus-visible { outline: 2px solid #1b5745; outline-offset: 3px; }
+.theme-horizon .recharts-cartesian-grid line { stroke: var(--pane-edge); }
+.theme-horizon .recharts-text { fill: var(--dim); }
+@media (prefers-reduced-motion: reduce) { .theme-horizon *, .theme-horizon *::before, .theme-horizon *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
+
+.theme-horizon .aegis-opener-title { font-family:var(--font-serif),Georgia,serif; font-size:clamp(34px,3.2vw,46px); font-weight:400; line-height:1.1; letter-spacing:-.025em; }
+.theme-horizon .aegis-opener-eyebrow { font-family:var(--font-sans),sans-serif; font-size:10px; letter-spacing:.12em; }
+.theme-horizon .aegis-opener-sub { font-size:13px; line-height:1.8; }
+.theme-horizon .aegis-code { border-radius:5px; font-family:var(--font-sans),sans-serif; background:#edf1e5; color:#416448; }
+
+.theme-horizon .aegis-sidebar .aegis-brand { font-size:26px; }

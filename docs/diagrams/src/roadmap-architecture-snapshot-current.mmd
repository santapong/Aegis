%% Aegis — architecture snapshot (C4 container view).
%% C4 model, flowchart syntax: see THEME.md.
flowchart TB
    subgraph aegis["Aegis"]
        direction LR
        frontend["<b>Frontend</b><br/><small><i>Next.js 15 · React 19 · Bun</i></small><br/><small>Landing · Dashboard · Calendar · Gantt · Reports<br/>Transactions · Budgets · Debts · Savings · Plans<br/>AI Advisor · customizable widgets · Onboarding · Command palette</small><br/><small><i>Tailwind v4 · shadcn/ui · Recharts · Zustand<br/>React Query v5 · react-virtual · react-hotkeys-hook · driver.js</i></small>"]
        backend["<b>Backend</b><br/><small><i>Python 3.11+ · FastAPI</i></small><br/><small>Auth · Plans · Transaction search · Budgets · Savings<br/>Debts · Stripe payments · CSV/PDF reports · Notifications<br/>AI via Claude tool_use</small><br/><small><i>SQLAlchemy 2.0 · Alembic · Pydantic v2<br/>WeasyPrint · matplotlib · Jinja2</i></small>"]
        db[("<b>Database</b><br/><small><i>SQLite · PostgreSQL · MySQL</i></small><br/><small>Selected via DATABASE_URL</small>")]
    end

    frontend -->|"REST<br/>JWT cookie"| backend
    backend -->|"reads / writes<br/>SQLAlchemy"| db

    classDef container fill:#e0f5fd,stroke:#0891b2,stroke-width:1.5px,color:#0e3a49
    classDef datastore fill:#cbeefb,stroke:#0e7490,stroke-width:1.5px,color:#0e3a49

    class frontend,backend container
    class db datastore

    style aegis fill:#fbfdfe,stroke:#94a3b8,stroke-width:1.2px,color:#0f2b36,stroke-dasharray:6 4

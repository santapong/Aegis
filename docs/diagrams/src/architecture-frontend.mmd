        backdrop["<b>Backdrop</b><br/><small><i>shell/backdrop.tsx</i></small><br/><small>Cosmic layers on marketing routes only;<br/>body.route-app zeroes glow tokens</small>"]
        pages["<b>Route pages</b><br/><small><i>app/{route}/page.tsx</i></small><br/><small>welcome · login · register · dashboard<br/>transactions · budgets · savings · debts · investments<br/>plans · calendar · gantt · trips · reports · settings · docs<br/>(/payments exists but is hidden from nav)</small>"]
        widgets["<b>Dashboard widgets</b><br/><small><i>dashboard/</i></small><br/><small>7 sections from persisted order;<br/>customize-menu hides / reorders / resets</small>"]
        ui["<b>ui/</b><br/><small><i>shadcn/ui + custom</i></small><br/><small>button · dialog · table<br/>sidebar with collapsible clusters</small>"]
        shell["<b>shell/</b><br/><small><i>Themed wrappers</i></small><br/><small>kpi · galaxy-card · sparkline · black-hole</small>"]
        charts["<b>charts/</b><br/><small><i>Recharts wrappers</i></small><br/><small>spending · cashflow · trend</small>"]
        feature["<b>Feature components</b><br/><small><i>auth/ ai/ search/</i></small><br/><small>auth-gate · google-sign-in · ai-panel<br/>command-palette · onboarding tour</small>"]
        lib["<b>lib/ hooks/ stores/</b><br/><small><i>TypeScript</i></small><br/><small>api.ts fetch client · utils · animations · use-toast<br/>auth / app / notification Zustand stores<br/>app store persists theme, clusters, widget order</small>"]
    end

    layout -->|"mounts once"| backdrop
    layout -->|"renders"| pages
    pages -->|"dashboard renders"| widgets
    pages -->|"composes"| ui
    pages -->|"composes"| shell
    pages -->|"composes"| charts
    pages -->|"composes"| feature
    pages -->|"fetches + state via"| lib
    widgets -->|"order / visibility<br/>from app store"| lib
    feature -->|"uses"| lib

    classDef container fill:#e0f5fd,stroke:#0891b2,stroke-width:1.5px,color:#0e3a49

    class layout,backdrop,pages,widgets,ui,shell,charts,feature,lib container


  "theme": "base",
  "themeVariables": {
    "fontFamily": "ui-sans-serif, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontSize": "14px",
    "lineColor": "#64748b",
    "edgeLabelBackground": "#ffffff",

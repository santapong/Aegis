C4Container
    title Aegis — container view (C4 level 2)

    Person(user, "User", "Manages personal finances in the browser")

    System_Boundary(aegis, "Aegis") {
        Container(frontend, "Frontend", "Next.js 15 / React 19", "App Router pages, Zustand stores + React Query v5, /api/* rewrite proxy")
        Container(backend, "Backend API", "FastAPI / Python 3.11+", "Middleware stack, domain routers, service layer")
        Container(worker, "Worker", "arq", "Background jobs")
        ContainerDb(db, "Database", "SQLite / Postgres / MySQL", "Domain data, selected via DATABASE_URL")
        ContainerDb(cache, "Redis", "cache + rate-limit + arq queue")
    }

    System_Ext(stripe, "Stripe", "Payments: checkout + webhooks, test mode")
    System_Ext(llm, "LLM providers", "Anthropic / Typhoon / Groq")

    Rel(user, frontend, "Uses", "HTTPS")
    Rel(frontend, backend, "REST /api/*", "JSON, JWT cookie")
    Rel(backend, db, "Reads / writes", "SQLAlchemy 2.0")
    Rel(backend, cache, "Caches, rate-limits, enqueues")
    Rel(backend, llm, "AI advisor calls", "tool_use")
    BiRel(backend, stripe, "Checkout + webhooks")
    Rel(worker, cache, "Dequeues jobs")
    Rel(worker, db, "Reads / writes")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

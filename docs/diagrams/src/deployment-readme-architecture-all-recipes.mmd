%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "ui-sans-serif, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontSize": "14px",
    "lineColor": "#64748b",
    "edgeLabelBackground": "#ffffff",
    "primaryTextColor": "#0f2b36"
  },
  "flowchart": { "curve": "basis", "nodeSpacing": 55, "rankSpacing": 75, "padding": 12 }
}}%%
%% Shared shape of every deploy recipe (C4 container view).
%% C4 model, flowchart syntax: see THEME.md.
flowchart LR
    user(["<b>User</b><br/><small>Browser</small>"])
    fe["<b>Frontend</b><br/><small><i>Next.js</i></small><br/><small>Serves the SPA<br/>proxies /api/* server-side</small>"]
    be["<b>Backend</b><br/><small><i>FastAPI</i></small><br/><small>JWT auth · business logic<br/>Stripe · Anthropic · WeasyPrint</small>"]
    db[("<b>Postgres</b><br/><small><i>managed or self-hosted</i></small>")]

    user -->|"HTTPS"| fe
    fe -->|"/api/*<br/>server-side proxy"| be
    be -->|"SQL"| db

    classDef person fill:#e2e8f0,stroke:#475569,stroke-width:1.5px,color:#1e293b
    classDef container fill:#e0f5fd,stroke:#0891b2,stroke-width:1.5px,color:#0e3a49
    classDef datastore fill:#cbeefb,stroke:#0e7490,stroke-width:1.5px,color:#0e3a49

    class user person
    class fe,be container
    class db datastore

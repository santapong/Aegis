%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "ui-sans-serif, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontSize": "14px",
    "lineColor": "#64748b",
    "edgeLabelBackground": "#ffffff",
    "primaryTextColor": "#0f2b36"
  },
  "flowchart": { "curve": "basis", "nodeSpacing": 55, "rankSpacing": 75, "padding": 12 }
}}%%
%% Aegis — architecture at a glance (C4 container view).
%% C4 *model*, drawn as a flowchart: mermaid's native C4 renderer lays shapes on
%% a fixed grid and routes edges straight through them, which made this
%% unreadable. Role colours are defined in the classDef block — see
%% docs/diagrams/THEME.md for the palette and what each role means.
flowchart TB
    user(["<b>User</b><br/><small>Browser</small>"])

    subgraph aegis["Aegis"]
        direction LR
        frontend["<b>Frontend</b><br/><small><i>Next.js 15 · React 19</i></small><br/><small>App Router · Zustand · React Query v5</small>"]
        backend["<b>Backend API</b><br/><small><i>FastAPI · Python 3.11+</i></small><br/><small>JWT cookie auth · domain routers · AI engine</small>"]
        worker["<b>Worker</b><br/><small><i>arq</i></small><br/><small>Background jobs</small>"]
        db[("<b>Database</b><br/><small><i>Postgres · MySQL · SQLite</i></small>")]
        cache[("<b>Redis</b><br/><small><i>cache · rate-limit · queue</i></small>")]
    end

    stripe["<b>Stripe</b><br/><small><i>Payments · test mode</i></small>"]
    llm["<b>LLM provider</b><br/><small><i>Claude · Typhoon · Groq</i></small>"]

    user -->|"HTTPS"| frontend
    frontend -->|"REST /api/*<br/>JSON · JWT cookie"| backend
    backend -->|"reads / writes"| db
    backend -->|"cache · rate-limit"| cache
    backend -->|"enqueue<br/>arq / Redis"| worker
    worker -->|"reads / writes"| db
    backend -.->|"AI advisor · tool_use"| llm
    backend -.->|"checkout + webhooks"| stripe

    classDef person fill:#e2e8f0,stroke:#475569,stroke-width:1.5px,color:#1e293b
    classDef container fill:#e0f5fd,stroke:#0891b2,stroke-width:1.5px,color:#0e3a49
    classDef datastore fill:#cbeefb,stroke:#0e7490,stroke-width:1.5px,color:#0e3a49
    classDef external fill:#f1f5f9,stroke:#94a3b8,stroke-width:1.5px,color:#475569,stroke-dasharray:4 3

    class user person
    class frontend,backend,worker container
    class db,cache datastore
    class stripe,llm external

    style aegis fill:#fbfdfe,stroke:#94a3b8,stroke-width:1.2px,color:#0f2b36,stroke-dasharray:6 4

C4Container
    title Aegis — architecture at a glance (C4 container view)

    Person(user, "User", "Browser")

    System_Boundary(aegis, "Aegis") {
        Container(frontend, "Frontend", "Next.js 15 / React 19", "App Router pages: Dashboard, Transactions, Plans, AI. Zustand + React Query v5, /api/* rewrite proxy")
        Container(backend, "Backend API", "FastAPI / Python 3.11+", "JWT cookie auth, domain routers, AI engine, WeasyPrint PDF + matplotlib")
        Container(worker, "Worker", "arq", "Background jobs")
        ContainerDb(db, "Database", "SQLite / Postgres / MySQL")
        ContainerDb(cache, "Redis", "cache + rate-limit + job queue")
    }

    System_Ext(stripe, "Stripe", "Payments, test mode")
    System_Ext(llm, "LLM provider", "Claude / Typhoon / Groq")

    Rel(user, frontend, "Uses", "HTTPS")
    Rel(frontend, backend, "REST /api/*", "JSON, JWT cookie")
    Rel(backend, db, "Reads / writes")
    Rel(backend, cache, "Caches + rate-limits")
    Rel(backend, llm, "AI advisor", "tool_use")
    BiRel(backend, stripe, "Checkout + webhooks")
    Rel(backend, worker, "Enqueues jobs", "arq / Redis")
    Rel(worker, db, "Reads / writes")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

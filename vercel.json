{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "python scripts/release_schema.py",
      "entrypoint": "main.py"
    }
  },
  "redirects": [
    {
      "source": "/brand",
      "destination": "/landing",
      "permanent": true
    },
    {
      "source": "/brand/",
      "destination": "/landing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/:path*/",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

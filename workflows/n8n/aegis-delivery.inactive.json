    {
      "id": "3984b736-729d-561c-89ac-035e035e512f",
      "name": "Frozen LINE request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const d=$json.delivery;if(!d||typeof d.payload?.to!=='string'||!Array.isArray(d.payload.messages)||!d.retry_key)throw new Error('Invalid frozen delivery');return [{json:{delivery:d,payload:d.payload,fixture_mode:$('Settings').first().json.fixture_mode}}];"
      }
    },

      "parameters": {
        "content": "## INACTIVE \u2014 fictional fixture by default\nTarget: n8n 2.33.3. Manual trigger only. Set Settings.fixture_mode=false only after G1/G2 review. Select separate Header Auth credentials for ingestion claim, delivery claim and LINE push. Lease headers are server issued. Never add direct ledger/database writes. Save execution data: none. Do not pin real financial data.",
        "height": 250,
        "width": 650
      }
    },
    {
      "id": "2221d2ac-0c10-527d-a639-9ff789985cd3",
      "name": "Fixture delivery?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "38b2788c-60c2-559f-baca-81b353effeba",
              "leftValue": "={{ $json.fixture_mode === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b2ce7657-2380-5228-9f60-21c39b0ca4b4",
      "name": "Fixture delivery claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -150
      ],
      "parameters": {
        "jsCode": "return [{json:{delivery:{id:'00000000-0000-4000-8000-000000000001',generation:1,lease_token:'fixture-delivery-capability',retry_key:'00000000-0000-4000-8000-000000000001',payload:{to:'U00000000000000000000000000000000',messages:[{type:'text',text:'FICTIONAL fixture: draft awaiting review. Nothing recorded.'}]}}}}];"
      }
    },

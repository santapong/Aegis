      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        350
      ],
      "parameters": {
        "jsCode": "return [{json:{state:$json.error?'claim_failed':'idle',no_money_posted:true,action:'Inspect safe operations state; never repost a financial command'}}];"
      }
    },
    {
      "id": "b3c0d8bb-753d-51b3-a332-edb4fa55dff4",
      "name": "Validate job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const j=$json.job;if(!j || !['text','extract'].includes(j.kind) || !Number.isInteger(j.generation) || j.generation<1 || typeof j.lease_token!=='string')throw new Error('Invalid source-bound job');return [{json:{job:j,fixture_mode:$('Settings').first().json.fixture_mode}}];"
      }
    },

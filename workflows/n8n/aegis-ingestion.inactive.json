      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -80
      ],
      "parameters": {
        "jsCode": "if(!$json.draft_id)throw new Error('Missing durable draft result');return [{json:{state:'awaiting_owner_review',draft_id:$json.draft_id,version:$json.version,no_money_posted:true}}];"
      }
    },
    {
      "id": "dcc46320-42c5-5d39-a512-4386eb98537c",
      "name": "Normalize process response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        150
      ],
      "parameters": {
        "jsCode": "const r=$json;if(r.error)return [{json:{process_error:true,stop:false,retryable:true,code:'PROVIDER_UNAVAILABLE'}}];const status=r.statusCode||200;const body=r.body||{};if(status>=200&&status<300)return [{json:{...body,process_error:false}}];const d=body.detail||{};const allowed=['EXTRACTION_FAILED','CAPTURE_FAILED','INVALID_MEDIA','PROVIDER_UNAVAILABLE','INVALID_TEXT'];return [{json:{process_error:true,stop:[401,403,409].includes(status),retryable:typeof d.retryable==='boolean'?d.retryable:status>=500,code:allowed.includes(d.code)?d.code:'EXTRACTION_FAILED'}}];"
      }
    },
